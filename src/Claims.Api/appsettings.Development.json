{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MotorPropertyClaimsDb;Integrated Security=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "MotorPropertyClaims.Api",
    "Audience": "MotorPropertyClaims.Client",
    "AccessTokenMinutes": 30
  },
  "DevelopmentUsers": {
    "Enabled": true,
    "Claimant": {
      "Email": "claimant@example.com",
      "FullName": "Demo Claimant"
    },
    "ClaimsOfficer": {
      "Email": "officer@example.com",
      "FullName": "Demo Claims Officer"
    },
    "Manager": {
      "Email": "manager@example.com",
      "FullName": "Demo Manager"
    }
  },
  "IdentitySeeding": {
    "Enabled": true
  },

  "Approval": {
    "ClaimsOfficerLimit": 10000,
    "CurrencyCode": "MYR"
  }
}
